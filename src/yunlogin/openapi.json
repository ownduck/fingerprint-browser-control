                    "maxLength": 40
                  }
                }
              },
              "example": {
                "name": "xxx"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "code": 0,
                  "msg": "Success",
                  "data": {
                    "groupid": "fdrgdgsfgsertgreaay34575422",

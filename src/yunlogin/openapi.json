    "/api/v2/userapi/group/list": {
      "post": {
        "tags": [
          "分组管理"
        ],
        "summary": "查询分组",
        "description": "分页模糊查询分组。offer 最小 0，number 最大 20。注意返回字段官方写作 gropid。",
        "operationId": "groupList",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "offer",
                  "number"
                ],
                "properties": {
                  "group": {
                    "type": "string"
                  },
                  "offer": {
                    "type": "integer"
                  },
                  "number": {
                    "type": "integer",
                    "maximum": 20
                  }
                }
              },
              "example": {
                "group": "xxx",
                "offer": 1,
                "number": 20
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "code": 0,
                  "msg": "Success",
                  "data": {
                    "group": [
                      {
                        "name": "指纹浏览器测试分组-1",
                        "gropid": "fdrgdgsfgsertgreaay34575422"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/userapi/user/create": {
      "post": {
        "tags": [
          "环境管理"
        ],
        "summary": "创建浏览器指纹",
        "description": "browser 数组创建环境；proxy.type 支持 self/general/socks5/http/https/local。同步 cookie 时 accounts.cookie 请传 \"[]\"。",
        "operationId": "userCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "browser"
                ],
                "properties": {
                  "browser": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "example": {
                "browser": [
                  {
                    "name": "指纹浏览器",
                    "proxy": {
                      "type": "local",
                      "uuid": "",
                      "PublicIP": "",
                      "region": "",
                      "https": {
                        "Addr": ""
                      }
                    },
                    "accounts": {
                      "openurls": [
                        ""
                      ],
                      "groupid": "",
                      "cookie": ""
                    },
                    "accountsv2": [
                      {
                        "url": "",
                        "user": "",
                        "password": ""
                      }
                    ],
                    "finger": {
                      "kernelversion": "107"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "code": 0,
                  "msg": "Success",
                  "data": {}
                }
              }
            }
          }
        }
      }
    },

                      "type": "string"
                    }
                  }
                }
              },
              "example": {
                "browserid": [
                  "d03ca5de08ec8e02c4b78558ee84d7fc"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "code": 0,
                  "msg": "Success",
                  "data": {
                    "browser": [
                      {
                        "browserid": "608b78e0c121e262712eaeaba1aa98e1",
                        "name": "云登浏览器_3"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/userapi/group/create": {
      "post": {
        "tags": [
          "分组管理"
        ],
        "summary": "创建分组",
        "description": "创建分组，返回 groupid。",
        "operationId": "groupCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [

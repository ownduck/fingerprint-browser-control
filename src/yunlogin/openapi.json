{
  "openapi": "3.0.3",
  "info": {
    "title": "云登浏览器 Local API",
    "description": "整理自 https://www.yunlogin.com/openapi（与客户端「自动化 → API」同源）。\n\nBase: http://localhost:50213\n\n约定：参数多为字符串；POST body 为 JSON；各接口每秒最多 1 次。\n注意：正式本地接口以 /api/v2 为主；环境 ID 字段常用 account_id / browserid / shopid。",
    "version": "4.0.3.5",
    "contact": {
      "name": "YunLogin OpenAPI",
      "url": "https://www.yunlogin.com/openapi"
    }
  },
  "servers": [
    {
      "url": "http://localhost:50213",
      "description": "默认本地地址"
    },
    {
      "url": "http://127.0.0.1:50213",
      "description": "本机回环"
    }
  ],
  "tags": [
    {
      "name": "概览"
    },
    {
      "name": "浏览器"
    },
    {
      "name": "分组管理"
    },
    {
      "name": "环境管理"
    },
    {
      "name": "自有代理管理"
    },
    {
      "name": "插件中心"
    },
    {
      "name": "Cookies管理"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "tags": [
          "概览"
        ],
        "summary": "API接口状态",
        "description": "检查 Local API 可用性。",
        "operationId": "getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "code": 0,
                  "msg": "success"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/browser/start": {
      "get": {
        "tags": [
          "浏览器"
        ],
        "summary": "启动浏览器",
        "description": "启动环境浏览器，返回 debuggingPort / ws / webdriver，可用于 Selenium/Puppeteer。",
        "operationId": "startBrowser",
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "环境ID"
          },
          {
            "name": "headless",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                1
              ]
            },
            "description": "1=无头"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "code": 0,
                  "msg": "success",
                  "data": {
                    "debuggingPort": "xxxx",
                    "webdriver": "C:\\xxxx\\chromedriver.exe",
                    "ws": {
                      "selenium": "127.0.0.1:xxxx",
                      "puppeteer": "ws://127.0.0.1:xxxx/devtools/browser/xxxxxx"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/browser/stop": {
      "get": {
        "tags": [
          "浏览器"
        ],
        "summary": "关闭浏览器",
        "description": "关闭指定环境浏览器。",
        "operationId": "stopBrowser",
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "code": 0,
                  "msg": "success"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/browser/status": {
      "get": {
        "tags": [
          "浏览器"
        ],
        "summary": "检测启动状态",
        "description": "查询环境浏览器是否 Active，并返回 ws。",
        "operationId": "browserStatus",
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "code": 0,
                  "data": {
                    "status": "Active",
                    "ws": {
                      "selenium": "127.0.0.1:xxxx",
                      "puppeteer": "ws://127.0.0.1:xxxx/devtools/browser/xxxxxx"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

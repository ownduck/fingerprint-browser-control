  "components": {
    "schemas": {
      "BasicResult": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SelfProxy": {
        "type": "object",
        "required": [
          "name",
          "proxytype",
          "proxyaddr"
        ],
        "properties": {
          "deviceid": {
            "type": "string",
            "description": "更新时必填"
          },
          "name": {
            "type": "string"
          },
          "proxytype": {
            "type": "integer",
            "description": "1有账密socks5;3无账密socks5;4http;5https;6http有账密;7https有账密;更新时0表示不改"
          },
          "proxyaddr": {
            "type": "string",
            "example": "1.1.1.1:2333"
          },
          "proxyu": {
            "type": "string"
          },
          "proxyp": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "CookieItem": {
        "type": "object",
        "required": [
          "name",
          "value",
          "domain"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "expirationDate": {
            "type": "number"
          },
          "hostOnly": {
            "type": "boolean"
          },
          "httpOnly": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "sameSite": {
            "type": "string",
            "enum": [
              "Strict",
              "Lax",
              "None",
              ""
            ]
          },
          "secure": {
            "type": "boolean"
          },
          "session": {
            "type": "boolean"
          },
          "storeId": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          }
        }
      }
    }
  }
